# Скопируй в gradle.properties и при необходимости раскомментируй JDK:
#   cp gradle.properties.example gradle.properties
#
# Файл gradle.properties в репозиторий не коммитится (.gitignore) — у каждого свой путь к JDK.

org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
android.useAndroidX=true
kotlin.code.style=official
android.nonTransitiveRClass=true

# Раскомментируй и укажи свой JDK 17/21 (или задай JAVA_HOME вместо этой строки):
# org.gradle.java.home=/path/to/jdk-21/Contents/Home
